  "questionRoutingRules": {
    "bySubtopicAndDifficulty": {
      "strategy": "filename_inference",
      "logicForCopilot": [
        "Scan the Math Knowledge content directory or zip for all JSON files except math_schema.json.",
        "Assume filenames follow the pattern `<subtopicId>_<difficulty>_part<index>.json`.",
        "Infer `subtopicId` and `difficulty` from the filename; normalize difficulty to one of: `beginner`, `advanced`, `expert`.",
        "Load each file and append all `questions[]` into an in-memory registry keyed as `questions['math_knowledge'][subtopicId][difficulty]`.",
        "Use `subjects[].mappedGameSubtopics` to validate that `subtopicId` is recognized and mark whether it is an official AFOQT topic.",
        "Use this registry for study mode, drill mode, and AFOQT-style practice tests for Math Knowledge."
      ]
    }
  }
