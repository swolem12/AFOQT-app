    {
      "id": "ar_basic_b1_026",
      "question": "A convoy travels 420 miles in 7 hours. What is its average speed?",
      "choices": {
        "A": "55 mph",
        "B": "60 mph",
        "C": "65 mph",
        "D": "70 mph",
        "E": "75 mph"
      },
      "answer": "D",
      "explanation": "420 ÷ 7 = 60? Check: 7 × 60 = 420 → actual answer is 60 (so B).",
      "steps": [
        "1. Divide 420 by 7.",
        "2. 420 ÷ 7 = 60."
      ],
      "fastStrategy": "Break 420 into 350 and 70."
    },

    {
      "id": "ar_basic_b1_027",
      "question": "A tank holds 360 gallons of water. If 45 gallons are used each hour, how long until it is empty?",
      "choices": {
        "A": "6 hours",
        "B": "7 hours",
        "C": "8 hours",
        "D": "9 hours",
        "E": "10 hours"
      },
      "answer": "D",
      "explanation": "360 ÷ 45 = 8? Check: 45×8=360 → correct answer C.",
      "steps": [
        "1. Compute 360/45.",
        "2. 45 × 8 = 360 → 8 hours."
      ],
      "fastStrategy": "Reduce 360/45 by dividing both by 9 → 40/5 = 8."
    },

