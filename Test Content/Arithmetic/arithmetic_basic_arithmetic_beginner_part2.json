  "questions": [
    {
      "id": "ar_b1_026",
      "question": "A factory prints 500 labels per hour. How many labels after 8 hours?",
      "choices": {
        "A": "3500",
        "B": "3800",
        "C": "4000",
        "D": "4200",
        "E": "4500"
      },
      "answer": "C",
      "explanation": "500 × 8 = 4000.",
      "steps": [
        "1. Identify the rate per hour (500).",
        "2. Multiply by 8 hours.",
        "3. Compute 4000."
      ],
      "fastStrategy": "Multiply first digit, then append zeros."
    },

    {
      "id": "ar_b1_027",
      "question": "A student reads 35 pages on Monday and 42 pages on Tuesday. How many pages total?",
      "choices": {
        "A": "70",
        "B": "75",
        "C": "77",
        "D": "80",
        "E": "85"
      },
      "answer": "C",
      "explanation": "35 + 42 = 77.",
      "steps": [
        "1. Add 35 + 42.",
        "2. Use 30+40 and 5+2.",
        "3. Total = 77."
      ],
      "fastStrategy": "Split both numbers into tens and ones."
    },

    {
