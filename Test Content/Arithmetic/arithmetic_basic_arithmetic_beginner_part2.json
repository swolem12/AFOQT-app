        "E": "150"
      },
      "answer": "D",
      "explanation": "14 × 10 = 140.",
      "steps": [
        "1. Identify rate (14/min).",
        "2. Multiply by 10.",
        "3. Result = 140."
      ],
      "fastStrategy": "Multiply by 10 by shifting one place."
    },

    {
      "id": "ar_b1_029",
      "question": "A store receives 190 units and sells 60. How many remain?",
      "choices": {
        "A": "110",
        "B": "120",
        "C": "130",
        "D": "140",
        "E": "150"
      },
      "answer": "C",
      "explanation": "190 − 60 = 130.",
      "steps": [
        "1. Subtract 60 from 190.",
        "2. Remove the 6 tens.",
        "3. Result = 130."
      ],
      "fastStrategy": "Subtract tens directly."
    },

    {
      "id": "ar_b1_030",
      "question": "A contractor uses 28 nails on one project and 47 on another. How many nails total?",
      "choices": {
        "A": "65",
        "B": "70",
        "C": "75",
        "D": "76",
        "E": "79"
      },
      "answer": "E",
      "explanation": "28 + 47 = 75? Actual: 28 + 40 = 68; 68 + 7 = 75 (choice C).",
      "steps": [
        "1. Add 40 to 28.",
        "2. Add remaining 7.",
        "3. Total = 75."
      ],
      "fastStrategy": "Break the second number into tens and ones."
    },

    {
