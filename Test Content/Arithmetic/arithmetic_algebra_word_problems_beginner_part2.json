    {
      "id": "ar_alg_b1_026",
      "question": "A machine produces 45 parts per hour. How many hours does it take to produce 315 parts?",
      "choices": {
        "A": "5",
        "B": "6",
        "C": "7",
        "D": "8",
        "E": "9"
      },
      "answer": "C",
      "explanation": "Let h be the hours. 45h = 315, so h = 315 ÷ 45 = 7.",
      "steps": [
        "1. Set up 45h = 315.",
        "2. Divide 315 by 45.",
        "3. h = 7 hours."
      ],
      "fastStrategy": "Think 45×7 = (40×7)+(5×7) = 280+35 = 315."
    },

    {
      "id": "ar_alg_b1_027",
      "question": "A pilot flies 360 miles at a constant speed of 120 miles per hour. How many hours does the flight take?",
      "choices": {
        "A": "2",
        "B": "2.5",
        "C": "3",
        "D": "3.5",
        "E": "4"
      },
      "answer": "C",
      "explanation": "Use d = rt → 360 = 120t → t = 360 ÷ 120 = 3.",
      "steps": [
        "1. Write 360 = 120t.",
        "2. Divide both sides by 120.",
        "3. t = 3 hours."
      ],
      "fastStrategy": "If rate is 120 mph, every hour is 120 miles → 360 miles = 3 hours."
    },

