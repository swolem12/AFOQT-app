      "id": "ar_basic_e1_004",
      "question": "Least common multiple of 84 and 126 is?",
      "choices": {"A": "168", "B": "210", "C": "224", "D": "252", "E": "336"},
      "answer": "D",
      "explanation": "84 = 2^2 × 3 × 7; 126 = 2 × 3^2 × 7. LCM = 2^2 × 3^2 × 7 = 4 × 9 × 7 = 252.",
      "steps": [
        "1. Prime factor 84 → 2^2 × 3 × 7.",
        "2. Prime factor 126 → 2 × 3^2 × 7.",
        "3. Take max powers: 2^2, 3^2, 7.",
        "4. Multiply: 4 × 9 × 7 = 252.",
        "5. Trap: Don't add exponents; choose the higher exponent per prime."
      ],
      "fastStrategy": "LCM = (Product) / GCD; 84×126 / 42 = 252."
    },
