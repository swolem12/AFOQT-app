      "id": "ar_basic_e1_001",
      "question": "Compute (72^2 - 48 × 27) ÷ 12.",
      "choices": {"A": "288", "B": "304", "C": "324", "D": "336", "E": "360"},
      "answer": "C",
      "explanation": "72^2 = 5184, 48 × 27 = 1296, difference = 3888, divide by 12 → 324.",
      "steps": [
        "1. Square 72: 72 × 72 = 5184.",
        "2. Multiply 48 × 27 = 1296.",
        "3. Subtract: 5184 − 1296 = 3888.",
        "4. Divide by 12: 3888 ÷ 12 = 324.",
        "5. Trap: Keep order of operations; divide only after subtracting."
      ],
      "fastStrategy": "Factor common 12: (12×432 − 12×108) ÷ 12 = 432 − 108 = 324."
    },
