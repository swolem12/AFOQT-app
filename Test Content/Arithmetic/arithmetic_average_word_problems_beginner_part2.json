    {
      "id": "ar_avg_b1_026",
      "question": "A technician completes 72 inspections in 6 hours. What is the average number of inspections per hour?",
      "choices": {
        "A": "10",
        "B": "11",
        "C": "12",
        "D": "13",
        "E": "14"
      },
      "answer": "C",
      "explanation": "Average rate = total ÷ time. 72 ÷ 6 = 12.",
      "steps": [
        "1. Identify total inspections: 72.",
        "2. Identify time: 6 hours.",
        "3. Compute 72 ÷ 6 = 12."
      ],
      "fastStrategy": "Divide by 6 using mental division: 60/6=10, 12/6=2 → 12."
    },

