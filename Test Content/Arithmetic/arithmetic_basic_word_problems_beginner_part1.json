    {
      "id": "ar_basic_b1_001",
      "question": "A worker packs 48 boxes in 6 hours. How many boxes does he pack per hour?",
      "choices": {
        "A": "6",
        "B": "7",
        "C": "8",
        "D": "9",
        "E": "10"
      },
      "answer": "C",
      "explanation": "Divide total boxes by hours worked. 48 ÷ 6 = 8.",
      "steps": [
        "1. Identify total: 48 boxes.",
        "2. Identify hours: 6.",
        "3. Compute 48 ÷ 6 = 8."
      ],
      "fastStrategy": "Divide 48 by 6 mentally using 42/6=7 plus the extra 6/6=1."
    },

    {
      "id": "ar_basic_b1_002",
      "question": "An aircraft uses 600 gallons of fuel on a 3-hour mission. What is the average fuel usage per hour?",
      "choices": {
        "A": "100",
        "B": "150",
        "C": "175",
        "D": "200",
        "E": "250"
      },
      "answer": "D",
      "explanation": "Fuel rate = 600 ÷ 3 = 200 gallons per hour.",
      "steps": [
        "1. Total fuel = 600 gallons.",
        "2. Time = 3 hours.",
        "3. 600 ÷ 3 = 200."
      ],
      "fastStrategy": "Divide by 3 by splitting 600 into 300 + 300."
    },

    {
      "id": "ar_basic_b1_003",
      "question": "A vehicle travels 180 miles in 4 hours. What is its average speed?",
      "choices": {
        "A": "35 mph",
        "B": "40 mph",
        "C": "42 mph",
        "D": "45 mph",
        "E": "50 mph"
      },
      "answer": "D",
      "explanation": "Speed = distance ÷ time = 180 ÷ 4 = 45 mph.",
      "steps": [
        "1. Divide 180 by 4.",
        "2. 180 ÷ 4 = 45."
      ],
      "fastStrategy": "Half twice: 180 → 90 → 45."
    },

