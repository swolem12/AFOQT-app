    {
      "id": "mk_frac_a_010",
      "question": "Convert to improper fraction: 3¾",
      "choices": {
        "A": "12/4",
        "B": "13/4",
        "C": "15/4",
        "D": "7/4",
        "E": "11/4"
      },
      "answer": "C",
      "explanation": "3¾ = (3 × 4 + 3)/4 = (12 + 3)/4 = 15/4.",
      "steps": [
        "1. Multiply whole number by denominator: 3 × 4 = 12.",
        "2. Add numerator: 12 + 3 = 15.",
        "3. Write over denominator: 15/4."
      ],
      "fastStrategy": "Mixed to improper: (whole × denom + numer) / denom."
    }
  ]
