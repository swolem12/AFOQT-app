    {
      "id": "pa_b1_005",
      "question": "What is the sum of the interior angles of a triangle?",
      "choices": {
        "A": "90°",
        "B": "180°",
        "C": "270°",
        "D": "360°",
        "E": "540°"
      },
      "answer": "B",
      "explanation": "A triangle's interior angles always sum to 180°.",
      "steps": [
        "1. The basic polygon angle formula: (n−2)×180°.",
        "2. For n=3: (3−2)×180° = 180°."
      ],
      "fastStrategy": "Triangle = 180° always."
    },

    {
      "id": "pa_b1_006",
      "question": "What is the sum of the interior angles of a quadrilateral?",
      "choices": {
        "A": "180°",
        "B": "270°",
        "C": "360°",
        "D": "540°",
        "E": "720°"
      },
      "answer": "C",
      "explanation": "Interior sum = (n−2)×180°. For a quadrilateral, n=4 → (4−2)×180° = 360°.",
      "steps": [
        "1. Use formula (n−2)×180°.",
        "2. Plug in n=4.",
        "3. Get 360°."
      ],
      "fastStrategy": "Quad = 4 sides → two triangles → 2×180° = 360°."
    },

    {
      "id": "pa_b1_007",
      "question": "What is the sum of interior angles of a pentagon?",
      "choices": {
        "A": "360°",
        "B": "450°",
        "C": "540°",
        "D": "600°",
        "E": "720°"
      },
      "answer": "C",
      "explanation": "Use (n−2)×180°. For n=5: 3×180°=540°.",
      "steps": [
        "1. Identify n=5.",
        "2. Compute 3×180°.",
        "3. Sum=540°."
      ],
      "fastStrategy": "Pentagon → 5 sides → 3 triangles → 540°."
    },

    {
      "id": "pa_b1_008",
      "question": "What is the sum of the interior angles of a hexagon?",
      "choices": {
        "A": "540°",
        "B": "600°",
        "C": "720°",
        "D": "900°",
        "E": "1080°"
      },
      "answer": "C",
      "explanation": "A hexagon has n=6 sides. Sum = (6−2)×180° = 4×180° = 720°.",
      "steps": [
        "1. Use (n−2)×180°.",
        "2. Plug in n=6.",
        "3. Compute 4×180°=720°."
      ],
      "fastStrategy": "Hex → 6 sides → 4 triangles → 720°."
    },

