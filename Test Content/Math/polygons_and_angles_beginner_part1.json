      },
      "answer": "D",
      "explanation": "Diagonals = n(n−3)/2 = 5(2)/2=5.",
      "steps": [
        "1. Plug n=5.",
        "2. 5*(5−3)/2=5."
      ],
      "fastStrategy": "Pentagon = 5 diagonals always."
    },

