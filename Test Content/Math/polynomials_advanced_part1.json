    {
      "id": "mk_poly_a_004",
      "question": "Multiply: x(3x + 2)",
      "choices": {
        "A": "3x + 2x",
        "B": "3x² + 2x",
        "C": "3x² + 2",
        "D": "3x + 2",
        "E": "x² + 2x"
      },
      "answer": "B",
      "explanation": "Distribute x: x × 3x + x × 2 = 3x² + 2x.",
      "steps": [
        "1. Distribute x to each term.",
        "2. x × 3x = 3x².",
        "3. x × 2 = 2x.",
        "4. Result: 3x² + 2x."
      ],
      "fastStrategy": "Distributive property: a(b + c) = ab + ac."
    }
