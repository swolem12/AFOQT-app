    {
      "id": "mk_poly_a_001",
      "question": "Simplify: (2x² + 3x - 1) + (x² - x + 4)",
      "choices": {
        "A": "3x² + 2x + 3",
        "B": "3x² + 4x + 3",
        "C": "3x² + 2x - 5",
        "D": "2x² + 2x + 3",
        "E": "3x² - 2x + 5"
      },
      "answer": "A",
      "explanation": "Combine like terms: (2x² + x²) + (3x - x) + (-1 + 4) = 3x² + 2x + 3.",
      "steps": [
        "1. Group x² terms: 2x² + x² = 3x².",
        "2. Group x terms: 3x - x = 2x.",
        "3. Group constants: -1 + 4 = 3.",
        "4. Result: 3x² + 2x + 3."
      ],
      "fastStrategy": "Combine like terms: same variable and exponent."
    },
    {
      "id": "mk_poly_a_002",
      "question": "Simplify: (5x³ + 2x² - x) - (2x³ - x² + 3x)",
      "choices": {
        "A": "3x³ + 3x² - 4x",
        "B": "3x³ + x² - 4x",
        "C": "3x³ - x² + 4x",
        "D": "7x³ + 3x² - 4x",
        "E": "3x³ + 3x² + 2x"
      },
      "answer": "A",
      "explanation": "Distribute negative: 5x³ + 2x² - x - 2x³ + x² - 3x. Combine: (5 - 2)x³ + (2 + 1)x² + (-1 - 3)x = 3x³ + 3x² - 4x.",
      "steps": [
        "1. Distribute negative sign: (5x³ + 2x² - x) - (2x³ - x² + 3x) = 5x³ + 2x² - x - 2x³ + x² - 3x.",
        "2. Combine x³: 5x³ - 2x³ = 3x³.",
        "3. Combine x²: 2x² + x² = 3x².",
        "4. Combine x: -x - 3x = -4x."
      ],
      "fastStrategy": "Distribute negative sign to all terms being subtracted."
    },
