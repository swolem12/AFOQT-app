      "id": "mk_fe_a_001",
      "question": "If f(x) = 3x² - 2x + 1, find f(2).",
      "choices": {
        "A": "5",
        "B": "9",
        "C": "13",
        "D": "15",
        "E": "21"
      },
      "answer": "B",
      "explanation": "f(2) = 3(2)² - 2(2) + 1 = 3(4) - 4 + 1 = 12 - 4 + 1 = 9.",
      "steps": [
        "1. Substitute x = 2: f(2) = 3(2)² - 2(2) + 1.",
        "2. Calculate powers: 3(4) - 2(2) + 1.",
        "3. Multiply: 12 - 4 + 1.",
        "4. Add/subtract: 9."
      ],
      "fastStrategy": "Substitute value; follow order of operations."
    },
