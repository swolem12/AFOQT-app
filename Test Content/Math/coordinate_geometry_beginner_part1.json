    {
      "uiSpec": {
        "type": "coordinate_grid_points",
        "width": 300,
        "height": 300,
        "showGrid": true,
        "xRange": [-5, 5],
        "yRange": [-5, 5],
        "points": [
          { "name": "A", "x": 2, "y": 3 }
        ],
        "styleHints": {
          "pointColor": "black",
          "labelColor": "black"
        }
      },
      "copilotInstruction": "Render a 10x10 coordinate grid (-5 to 5). Plot point A at (2,3) as a solid dot with label 'A' slightly above-right. Use clean grid lines.",
      "id": "cg_b_001",
      "question": "On the coordinate plane, point A is plotted at (2, 3). In which quadrant is point A located?",
      "choices": {
        "A": "Quadrant I",
        "B": "Quadrant II",
        "C": "Quadrant III",
        "D": "Quadrant IV",
        "E": "On an axis"
      },
      "answer": "A",
      "explanation": "Quadrant I contains all points with positive x and positive y. Since (2,3) has x>0 and y>0, it is in Quadrant I.",
      "steps": [
        "1. Identify the signs: x=2>0, y=3>0.",
        "2. Quadrant I has (+,+).",
        "3. Therefore, A lies in Quadrant I."
      ],
      "fastStrategy": "Quadrant I = (++), II = (-,+), III = (--), IV = (+,-)."
    },

    {
