      "question": "What is the distance between H(1, 2) and I(4, 6)?",
      "choices": {
        "A": "4 units",
        "B": "5 units",
        "C": "√13 units",
        "D": "√20 units",
        "E": "√25 units"
      },
      "answer": "B",
      "explanation": "Use distance formula: √[(4−1)² + (6−2)²] = √(3² + 4²) = √25 = 5 units.",
      "steps": [
        "1. Compute Δx = 4−1 = 3.",
        "2. Compute Δy = 6−2 = 4.",
        "3. Use √(3² + 4²) = √25 = 5."
      ],
      "fastStrategy": "Spot the 3–4–5 triangle pattern."
    },

