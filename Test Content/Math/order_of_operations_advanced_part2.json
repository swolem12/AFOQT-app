      "question": "Calculate: 15 - 8 ÷ 2 + 3",
      "choices": {
        "A": "6.5",
        "B": "10",
        "C": "14",
        "D": "18",
        "E": "20"
      },
      "answer": "C",
      "explanation": "Divide first: 8 ÷ 2 = 4. Then left-to-right: 15 - 4 + 3 = 11 + 3 = 14.",
      "steps": [
        "1. Divide: 8 ÷ 2 = 4.",
        "2. Subtract: 15 - 4 = 11.",
        "3. Add: 11 + 3 = 14."
      ],
      "fastStrategy": "Division before addition/subtraction."
