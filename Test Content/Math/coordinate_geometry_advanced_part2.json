      "question": "Find the distance between (0, 0) and (6, 8).",
      "choices": {
        "A": "8",
        "B": "10",
        "C": "12",
        "D": "14",
        "E": "100"
      },
      "answer": "B",
      "explanation": "Distance = √((x₂-x₁)² + (y₂-y₁)²) = √(6² + 8²) = √(36 + 64) = √100 = 10.",
      "steps": [
        "1. Use distance formula: √((x₂-x₁)² + (y₂-y₁)²).",
        "2. Substitute: √(6² + 8²).",
        "3. Calculate: √(36 + 64) = √100 = 10."
      ],
      "fastStrategy": "Distance formula; recognize 6-8-10 Pythagorean triple."
