    {
      "id": "mk_seq_a_002",
      "question": "Find the 5th term of the arithmetic sequence with first term 2 and common difference 3.",
      "choices": {
        "A": "11",
        "B": "12",
        "C": "14",
        "D": "15",
        "E": "17"
      },
      "answer": "C",
      "explanation": "Formula: aₙ = a₁ + (n - 1)d. a₅ = 2 + (5 - 1)(3) = 2 + 12 = 14.",
      "steps": [
        "1. Use formula: aₙ = a₁ + (n - 1)d.",
        "2. Substitute: a₅ = 2 + (5 - 1)(3).",
        "3. Calculate: 2 + 4(3) = 2 + 12 = 14."
      ],
      "fastStrategy": "Arithmetic sequence: aₙ = a₁ + (n - 1)d."
    },
    {
      "id": "mk_seq_a_003",
      "question": "Find the next term in the geometric sequence: 2, 6, 18, 54, ...",
      "choices": {
        "A": "108",
        "B": "162",
        "C": "180",
        "D": "200",
        "E": "216"
      },
      "answer": "B",
      "explanation": "Common ratio r = 3. Next term = 54 × 3 = 162.",
      "steps": [
        "1. Find ratio: 6 / 2 = 3.",
        "2. Verify: 18 / 6 = 3, 54 / 18 = 3.",
        "3. Next term: 54 × 3 = 162."
      ],
      "fastStrategy": "Geometric sequence: find common ratio r; next term = last × r."
    },
    {
      "id": "mk_seq_a_004",
      "question": "What is the 4th term of a geometric sequence with first term 5 and common ratio 2?",
      "choices": {
        "A": "20",
        "B": "40",
        "C": "50",
        "D": "80",
        "E": "100"
      },
      "answer": "B",
      "explanation": "Formula: aₙ = a₁ × r^(n-1). a₄ = 5 × 2^(4-1) = 5 × 2³ = 5 × 8 = 40.",
      "steps": [
        "1. Use formula: aₙ = a₁ × r^(n-1).",
        "2. Substitute: a₄ = 5 × 2^(4-1).",
        "3. Calculate: 5 × 2³ = 5 × 8 = 40."
      ],
      "fastStrategy": "Geometric sequence: aₙ = a₁ × r^(n-1)."
    }
