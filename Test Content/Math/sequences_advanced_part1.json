      "id": "mk_seq_a_001",
      "question": "Find the next term in the arithmetic sequence: 3, 7, 11, 15, ...",
      "choices": {
        "A": "18",
        "B": "19",
        "C": "20",
        "D": "21",
        "E": "22"
      },
      "answer": "B",
      "explanation": "Common difference d = 4. Next term = 15 + 4 = 19.",
      "steps": [
        "1. Identify the common difference: 7 - 3 = 4.",
        "2. Verify: 11 - 7 = 4, 15 - 11 = 4.",
        "3. Next term: 15 + 4 = 19."
      ],
      "fastStrategy": "Arithmetic sequence: find common difference d; next term = last + d."
