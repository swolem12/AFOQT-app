      "question": "If f(x) = 2x² + 3x - 1, find f(2).",
      "choices": {
        "A": "11",
        "B": "13",
        "C": "15",
        "D": "17",
        "E": "19"
      },
      "answer": "B",
      "explanation": "f(2) = 2(2)² + 3(2) - 1 = 2(4) + 6 - 1 = 8 + 6 - 1 = 13.",
      "steps": [
        "1. Substitute x = 2: f(2) = 2(2)² + 3(2) - 1.",
        "2. Calculate: 2(4) + 6 - 1.",
        "3. Simplify: 8 + 6 - 1 = 13."
      ],
      "fastStrategy": "Substitute value; follow order of operations."
    },
