      "question": "What is the sum of interior angles in a hexagon?",
      "choices": {
        "A": "540°",
        "B": "720°",
        "C": "900°",
        "D": "1080°",
        "E": "1260°"
      },
      "answer": "B",
      "explanation": "Sum = (n - 2) × 180° where n = 6. Sum = (6 - 2) × 180° = 4 × 180° = 720°.",
      "steps": [
        "1. Formula: (n - 2) × 180°.",
        "2. Hexagon: n = 6.",
        "3. Calculate: (6 - 2) × 180° = 720°."
      ],
      "fastStrategy": "Interior angle sum: (n - 2) × 180°."
    },
