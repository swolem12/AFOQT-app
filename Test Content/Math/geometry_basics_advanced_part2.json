      "question": "A right triangle has legs 5 and 12. What is the hypotenuse?",
      "choices": {
        "A": "10",
        "B": "13",
        "C": "15",
        "D": "17",
        "E": "20"
      },
      "answer": "B",
      "explanation": "Pythagorean theorem: c² = a² + b² = 5² + 12² = 25 + 144 = 169. c = √169 = 13.",
      "steps": [
        "1. Apply Pythagorean theorem: c² = 5² + 12².",
        "2. Calculate: c² = 25 + 144 = 169.",
        "3. Take square root: c = 13."
      ],
      "fastStrategy": "Pythagorean theorem; recognize 5-12-13 triple."
    },
