      "question": "What is the area of a circle with radius 4?",
      "choices": {
        "A": "4π",
        "B": "8π",
        "C": "12π",
        "D": "16π",
        "E": "20π"
      },
      "answer": "D",
      "explanation": "Area = πr² = π(4)² = 16π.",
      "steps": [
        "1. Use formula: A = πr².",
        "2. Substitute r = 4: A = π(4)².",
        "3. Calculate: A = 16π."
      ],
      "fastStrategy": "Circle area: πr²."
    },
