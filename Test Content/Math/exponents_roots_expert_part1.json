    {
      "id": "mk_er_e_001",
      "question": "Simplify: (x²/₃ × x⁴/₃) / x²",
      "choices": {
        "A": "x²",
        "B": "x",
        "C": "1",
        "D": "x⁰",
        "E": "1/x"
      },
      "answer": "C",
      "explanation": "Numerator: x^(2/3) × x^(4/3) = x^(2/3 + 4/3) = x^(6/3) = x². Divide by x²: x² / x² = 1.",
      "steps": [
        "1. Add exponents in numerator: 2/3 + 4/3 = 6/3 = 2.",
        "2. Numerator becomes: x².",
        "3. Divide: x² / x² = x^(2-2) = x⁰ = 1."
      ],
      "fastStrategy": "Product rule: x^a × x^b = x^(a+b); quotient rule: x^a / x^b = x^(a-b)."
    },
    {
      "id": "mk_er_e_002",
      "question": "Which is equivalent to ⁴√(81)?",
      "choices": {
        "A": "3",
        "B": "9",
        "C": "27",
        "D": "81",
        "E": "∜81 = 2.43..."
      },
      "answer": "A",
      "explanation": "⁴√(81) = 81^(1/4). Note 81 = 3⁴, so ⁴√(3⁴) = 3.",
      "steps": [
        "1. Express: ⁴√(81) = 81^(1/4).",
        "2. Factor 81: 81 = 3⁴.",
        "3. Apply: (3⁴)^(1/4) = 3^(4×1/4) = 3¹ = 3."
      ],
      "fastStrategy": "Recognize perfect powers for nth roots."
    }
  ]
