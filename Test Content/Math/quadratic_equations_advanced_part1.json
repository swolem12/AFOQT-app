    {
      "id": "mk_qe_a_003",
      "question": "Solve using quadratic formula: x² + 2x - 3 = 0",
      "choices": {
        "A": "x = 1 or x = -3",
        "B": "x = -1 or x = 3",
        "C": "x = 2 or x = -2",
        "D": "No real solution",
        "E": "Infinite solutions"
      },
      "answer": "A",
      "explanation": "Use quadratic formula: x = (-b ± √(b² - 4ac)) / 2a. With a = 1, b = 2, c = -3: x = (-2 ± √(4 + 12)) / 2 = (-2 ± 4) / 2. So x = 1 or x = -3.",
      "steps": [
        "1. Apply formula: x = (-b ± √(b² - 4ac)) / 2a.",
        "2. Calculate discriminant: 2² - 4(1)(-3) = 4 + 12 = 16.",
        "3. √16 = 4.",
        "4. x = (-2 + 4)/2 = 1 or x = (-2 - 4)/2 = -3."
      ],
      "fastStrategy": "Quadratic formula works for any quadratic."
    },
