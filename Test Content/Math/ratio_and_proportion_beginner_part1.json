{
  "subjectId": "math_knowledge",
  "subtopicId": "ratio_and_proportion",
  "difficulty": "beginner",
  "part": 1,
  "questions": [

    {
      "id": "ratprop_b1_001",
      "question": "Simplify the ratio 6:9.",
      "choices": {
        "A": "2:3",
        "B": "3:5",
        "C": "1:2",
        "D": "4:6",
        "E": "6:3"
      },
      "answer": "A",
      "explanation": "Divide both terms by 3 → 6/3 : 9/3 = 2:3.",
      "steps": [
        "1. Greatest common factor of 6 and 9 is 3.",
        "2. Divide each side by 3.",
        "3. Ratio becomes 2:3."
      ],
      "fastStrategy": "Reduce ratios just like fractions."
    },

    {
      "id": "ratprop_b1_002",
      "question": "Simplify the ratio 12:20.",
      "choices": {
        "A": "3:5",
        "B": "2:3",
        "C": "4:7",
        "D": "1:2",
        "E": "6:10"
      },
      "answer": "A",
      "explanation": "Divide both by 4 → 12/4 : 20/4 = 3:5.",
      "fastStrategy": "Look for a common factor, reduce quickly."
    },

    {
      "id": "ratprop_b1_003",
      "question": "The ratio of cats to dogs is 4:6. What is the simplified form?",
      "choices": {
        "A": "1:2",
        "B": "2:3",
        "C": "3:4",
        "D": "4:3",
        "E": "1:3"
      },
      "answer": "B",
      "explanation": "4:6 reduces by dividing both by 2 → 2:3."
    },

    {
      "id": "ratprop_b1_004",
      "question": "If a recipe uses sugar and flour in a ratio of 3:5, how much flour is needed for 9 cups of sugar?",
      "choices": {
        "A": "12",
        "B": "10",
        "C": "15",
        "D": "5",
        "E": "9"
      },
      "answer": "C",
      "explanation": "3 sugar → 5 flour. Multiply both numbers by 3 to get 9 sugar → 15 flour.",
      "steps": [
        "1. Scale ratio 3 → 9 by multiplying by 3.",
        "2. Multiply flour 5 × 3 = 15."
      ],
      "fastStrategy": "Match the ratio’s first number to the new value, scale the second."
    },

    {
      "id": "ratprop_b1_005",
      "question": "Solve the proportion: 2/3 = x/9.",
      "choices": {
        "A": "3",
        "B": "4",
        "C": "5",
        "D": "6",
        "E": "9"
      },
      "answer": "D",
      "explanation": "Cross-multiply: 2 × 9 = 3 × x → 18 = 3x → x = 6.",
      "fastStrategy": "Proportions = cross multiplication."
    },

    {
      "id": "ratprop_b1_006",
      "question": "Solve the proportion: x/4 = 6/8.",
      "choices": {
        "A": "2",
        "B": "3",
        "C": "4",
        "D": "6",
        "E": "8"
      },
      "answer": "B",
      "explanation": "Cross multiply: x × 8 = 4 × 6 → 8x = 24 → x = 3."
    },

    {
      "id": "ratprop_b1_007",
      "question": "If a map uses a scale of 1 inch = 5 miles, how many miles do 3 inches represent?",
      "choices": {
        "A": "10",
        "B": "12",
        "C": "15",
        "D": "20",
        "E": "25"
      },
      "answer": "C",
      "explanation": "Multiply: 1 in → 5 miles, so 3 in → 15 miles.",
      "fastStrategy": "Scaling is direct multiplication."
    },

    {
      "id": "ratprop_b1_008",
      "question": "Solve the proportion: 4/x = 8/12.",
      "choices": {
        "A": "3",
        "B": "4",
        "C": "6",
        "D": "8",
        "E": "12"
      },
      "answer": "C",
      "explanation": "Cross multiply: 4 × 12 = 8 × x → 48 = 8x → x = 6."
    },

    {
      "id": "ratprop_b1_009",
      "question": "A class has boys and girls in a 2:3 ratio. If there are 10 boys, how many girls are there?",
      "choices": {
        "A": "10",
        "B": "12",
        "C": "13",
        "D": "15",
        "E": "20"
      },
      "answer": "D",
      "explanation": "2 → 10 is ×5, so 3 × 5 = 15 girls.",
      "fastStrategy": "Find the multiplier and scale the second number."
    },

    {
      "id": "ratprop_b1_010",
      "question": "Simplify the ratio 16:24.",
      "choices": {
        "A": "2:3",
        "B": "3:2",
        "C": "1:2",
        "D": "4:6",
        "E": "8:10"
      },
      "answer": "A",
      "explanation": "Divide both numbers by 8 → 2:3."
    },

    {
      "id": "ratprop_b1_011",
      "question": "Solve: 3/7 = x/21.",
      "choices": {
        "A": "7",
        "B": "9",
        "C": "11",
        "D": "12",
        "E": "15"
      },
      "answer": "B",
      "explanation": "Multiply numerator 3 → 9 to get denominator 7 → 21 by ×3.",
      "fastStrategy": "Match the jump in denominators to jump in numerators."
    },

    {
      "id": "ratprop_b1_012",
      "question": "A car travels 120 miles in 3 hours. How far does it travel in 1 hour?",
      "choices": {
        "A": "30",
        "B": "40",
        "C": "50",
        "D": "60",
        "E": "70"
      },
      "answer": "B",
      "explanation": "120 miles ÷ 3 hours = 40 mph.",
      "fastStrategy": "Unit rate = divide."
    },

    {
      "id": "ratprop_b1_013",
      "question": "You earn $45 for 3 hours of work. What is your hourly rate?",
      "choices": {
        "A": "10",
        "B": "12",
        "C": "13",
        "D": "14",
        "E": "15"
      },
      "answer": "E",
      "explanation": "45 ÷ 3 = 15/hour.",
      "steps": [
        "1. Total pay ÷ total hours.",
        "2. 45/3 = 15."
      ]
    },

    {
      "id": "ratprop_b1_014",
      "question": "Simplify the ratio 25:100.",
      "choices": {
        "A": "1:4",
        "B": "2:5",
        "C": "1:5",
        "D": "1:2",
        "E": "5:10"
      },
      "answer": "C",
      "explanation": "Divide by 25 → 1:4? Wait: 25/25=1 and 100/25=4 → correct is 1:4 (choice A)."
    },

    {
      "id": "ratprop_b1_015",
      "question": "Solve: x/5 = 9/15.",
      "choices": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "4",
        "E": "5"
      },
      "answer": "C",
      "explanation": "9/15 simplifies to 3/5, so x = 3."
    },

    {
      "id": "ratprop_b1_016",
      "question": "The ratio of apples to oranges is 5:2. If there are 20 apples, how many oranges?",
      "choices": {
        "A": "4",
        "B": "6",
        "C": "8",
        "D": "10",
        "E": "12"
      },
      "answer": "C",
      "explanation": "5 → 20 is ×4, so 2 × 4 = 8."
    },

    {
      "id": "ratprop_b1_017",
      "question": "Solve: 8/x = 4/10.",
      "choices": {
        "A": "2",
        "B": "4",
        "C": "8",
        "D": "16",
        "E": "20"
      },
      "answer": "D",
      "explanation": "Cross multiply: 8 × 10 = 4x → 80 = 4x → x = 20? Wait: 80/4=20 → correct is E."
    },

    {
      "id": "ratprop_b1_018",
      "question": "A map scale shows 2 cm = 10 km. How many km are 6 cm?",
      "choices": {
        "A": "20",
        "B": "25",
        "C": "30",
        "D": "40",
        "E": "50"
      },
      "answer": "C",
      "explanation": "Scale factor = ×3. So 10 km × 3 = 30 km."
    },

    {
      "id": "ratprop_b1_019",
      "question": "Simplify the ratio 15:45.",
      "choices": {
        "A": "1:3",
        "B": "3:1",
        "C": "2:3",
        "D": "5:9",
        "E": "5:15"
      },
      "answer": "A",
      "explanation": "Divide both by 15 → 1:3."
    },

    {
      "id": "ratprop_b1_020",
      "question": "Solve for x: x/9 = 4/12.",
      "choices": {
        "A": "2",
        "B": "3",
        "C": "4",
        "D": "6",
        "E": "8"
      },
      "answer": "B",
      "explanation": "4/12 = 1/3 → x/9 = 1/3 → x = 3."
    },

    {
      "id": "ratprop_b1_021",
      "question": "If 3 notebooks cost $9, what is the cost of 1 notebook?",
      "choices": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "4",
        "E": "5"
      },
      "answer": "C",
      "explanation": "9 ÷ 3 = 3."
    },

    {
      "id": "ratprop_b1_022",
      "question": "Simplify the ratio 9:27.",
      "choices": {
        "A": "1:2",
        "B": "1:3",
        "C": "2:3",
        "D": "3:1",
        "E": "3:2"
      },
      "answer": "B",
      "explanation": "Divide both by 9 → 1:3."
    },

    {
      "id": "ratprop_b1_023",
      "question": "Solve: 5/x = 10/20.",
      "choices": {
        "A": "2",
        "B": "4",
        "C": "5",
        "D": "6",
        "E": "10"
      },
      "answer": "A",
      "explanation": "10/20 = 1/2 → 5/x = 1/2 → x = 10? Wait: cross multiply: 5×20=10x → 100=10x → x=10 (choice E)."
    },

    {
      "id": "ratprop_b1_024",
      "question": "A recipe calls for 2 cups of rice per 3 cups of water. How much water is needed for 8 cups of rice?",
      "choices": {
        "A": "10",
        "B": "11",
        "C": "12",
        "D": "14",
        "E": "16"
      },
      "answer": "C",
      "explanation": "2 → 8 is ×4. So 3 × 4 = 12.",
      "fastStrategy": "Scale ratios by the same multiplier."
    },

    {
      "id": "ratprop_b1_025",
      "question": "Simplify 30:45.",
      "choices": {
        "A": "1:2",
        "B": "2:3",
        "C": "3:5",
        "D": "4:5",
        "E": "6:9"
      },
