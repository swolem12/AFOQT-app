    {
      "id": "mk_re_a_001",
      "question": "Simplify: (x² - 4) / (x + 2)",
      "choices": {
        "A": "x - 2",
        "B": "x + 2",
        "C": "x - 4",
        "D": "(x - 2)/(x + 2)",
        "E": "Cannot simplify"
      },
      "answer": "A",
      "explanation": "Factor numerator: x² - 4 = (x - 2)(x + 2). So (x² - 4)/(x + 2) = (x - 2)(x + 2)/(x + 2) = x - 2 (when x ≠ -2).",
      "steps": [
        "1. Factor numerator: x² - 4 = (x - 2)(x + 2).",
        "2. Write: ((x - 2)(x + 2)) / (x + 2).",
        "3. Cancel (x + 2): x - 2.",
        "4. Note: x ≠ -2 (excluded value)."
      ],
      "fastStrategy": "Factor; cancel common terms."
    },
    {
      "id": "mk_re_a_002",
      "question": "Simplify: (3x / (x + 1)) + (2 / (x + 1))",
