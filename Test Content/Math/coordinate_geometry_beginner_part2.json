    {
      "id": "cg_b2_005",
      "question": "Find the distance between points (3, 4) and (7, 1).",
      "choices": {
        "A": "3",
        "B": "4",
        "C": "5",
        "D": "√25",
        "E": "5√2"
      },
      "answer": "C",
      "explanation": "Distance = √[(7−3)² + (1−4)²] = √(16 + 9) = √25 = 5.",
      "steps": [
        "1. Δx = 4, Δy = -3.",
        "2. Distance = √(16+9)=√25.",
        "3. √25 = 5."
      ],
      "fastStrategy": "Check if Δx and Δy form a 3–4–5 triangle."
    },

