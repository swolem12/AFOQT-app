    },

    {
      "id": "frac_b1_013",
      "question": "Add: 3/10 + 1/2.",
      "choices": {
        "A": "2/5",
        "B": "4/10",
        "C": "8/10",
        "D": "11/20",
        "E": "7/10"
      },
      "answer": "E",
      "explanation": "1/2 = 5/10 → 3/10 + 5/10 = 8/10 = 4/5? Wait: 8/10 simplifies to 4/5 → choice C is 8/10 but simplest is 4/5 (not shown). Given options, 8/10 corresponds to C.",
      "fastStrategy": "Convert to common denominator."
    },

    {
      "id": "frac_b1_014",
      "question": "Subtract: 7/8 − 1/4.",
      "choices": {
        "A": "5/8",
        "B": "4/8",
        "C": "3/8",
        "D": "2/8",
        "E": "1/8"
      },
      "answer": "A",
      "explanation": "1/4 = 2/8 → 7/8 − 2/8 = 5/8."
    },

    {
      "id": "frac_b1_015",
      "question": "Multiply: 4/5 × 5/8.",
      "choices": {
        "A": "1/2",
        "B": "4/8",
        "C": "5/4",
        "D": "3/8",
        "E": "2/5"
      },
      "answer": "A",
      "explanation": "Cross-cancel: 5 cancels → (4×1)/(1×8) = 4/8 = 1/2."
    },

    {
      "id": "frac_b1_016",
      "question": "Divide: 2/3 ÷ 4/9.",
      "choices": {
        "A": "2/3",
        "B": "3/2",
        "C": "3/4",
        "D": "1/2",
        "E": "5/6"
      },
      "answer": "B",
      "explanation": "Flip second: (2/3)×(9/4) = 18/12 = 3/2."
    },

    {
      "id": "frac_b1_017",
      "question": "Which fraction is greater: 5/12 or 4/9?",
      "choices": {
        "A": "5/12",
        "B": "4/9",
        "C": "Equal",
        "D": "Not determinable",
        "E": "They are the same"
      },
      "answer": "B",
      "explanation": "Compare using cross multiplication: 5×9=45, 4×12=48 → 48>45 so 4/9 is larger."
    },

