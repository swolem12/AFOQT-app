        "D": "2/9",
        "E": "3/9"
      },
      "answer": "B",
      "explanation": "Divide by 9 → 1/3."
    },

    {
      "id": "frac_b1_011",
      "question": "Convert the decimal 0.5 to a fraction.",
      "choices": {
        "A": "1/5",
        "B": "1/2",
        "C": "5/10",
        "D": "2/5",
