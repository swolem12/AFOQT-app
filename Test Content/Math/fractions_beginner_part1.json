  "part": 1,
  "questions": [

    {
      "id": "frac_b1_001",
      "question": "Simplify the fraction 12/18.",
      "choices": {
        "A": "2/3",
        "B": "3/5",
        "C": "4/9",
        "D": "6/12",
        "E": "1/3"
      },
      "answer": "A",
      "explanation": "The GCF of 12 and 18 is 6. Divide: 12/6 = 2, 18/6 = 3 → 2/3.",
      "fastStrategy": "Always divide by the greatest common factor."
    },

    {
      "id": "frac_b1_002",
      "question": "Which fraction is equivalent to 4/6?",
      "choices": {
        "A": "2/3",
        "B": "1/4",
        "C": "3/4",
        "D": "4/12",
        "E": "1/2"
      },
      "answer": "A",
      "explanation": "Divide numerator and denominator by 2 → 4/6 = 2/3."
    },

    {
      "id": "frac_b1_003",
      "question": "Convert 3/2 into a mixed number.",
      "choices": {
        "A": "1 1/2",
        "B": "2 1/2",
        "C": "3 1/2",
        "D": "1 2/3",
        "E": "2"
      },
      "answer": "A",
      "explanation": "3 ÷ 2 = 1 remainder 1 → 1 1/2."
    },

    {
      "id": "frac_b1_004",
      "question": "Convert the mixed number 2 3/4 to an improper fraction.",
      "choices": {
        "A": "8/3",
        "B": "11/4",
        "C": "7/4",
        "D": "9/2",
        "E": "10/3"
      },
      "answer": "B",
      "explanation": "Multiply whole × denominator: 2×4=8; add numerator: 8+3=11 → 11/4."
    },

    {
      "id": "frac_b1_005",
      "question": "Add the fractions: 1/4 + 2/4.",
      "choices": {
        "A": "1/2",
        "B": "3/4",
        "C": "4/8",
        "D": "3/8",
        "E": "2/4"
      },
      "answer": "B",
      "explanation": "Add numerators: 1+2=3 → 3/4.",
      "fastStrategy": "Same denominator → add numerators only."
    },

    {
      "id": "frac_b1_006",
      "question": "Subtract the fractions: 5/6 − 1/6.",
      "choices": {
        "A": "3/6",
        "B": "4/6",
        "C": "2/6",
        "D": "1/6",
        "E": "5/12"
      },
      "answer": "B",
      "explanation": "5 − 1 = 4 → 4/6 = 2/3 if simplified."
    },

    {
      "id": "frac_b1_007",
      "question": "Multiply: 2/3 × 3/4.",
      "choices": {
        "A": "1/2",
        "B": "2/4",
        "C": "6/12",
        "D": "6/12 = 1/2",
        "E": "All of the above are the same"
      },
      "answer": "E",
      "explanation": "2×3 = 6; 3×4 = 12 → 6/12 = 1/2.",
      "fastStrategy": "Multiply straight across."
    },

    {
      "id": "frac_b1_008",
      "question": "Divide: (3/5) ÷ (1/2).",
      "choices": {
        "A": "3/10",
        "B": "6/5",
        "C": "3/2",
        "D": "5/3",
        "E": "1/6"
      },
      "answer": "B",
      "explanation": "Dividing by a fraction = multiply by its reciprocal: 3/5 × 2/1 = 6/5.",
      "fastStrategy": "Keep, change, flip."
    },

    {
      "id": "frac_b1_009",
      "question": "Which is larger: 3/8 or 1/2?",
      "choices": {
        "A": "3/8",
        "B": "1/2",
        "C": "Equal",
        "D": "Depends on context",
        "E": "Not comparable"
      },
      "answer": "B",
      "explanation": "1/2 = 4/8, which is greater than 3/8."
    },

    {
